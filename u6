.under{font-weight:900;text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:3px;color:var(--brand)}
.action-row{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
.mini-btn{padding:10px 14px;background:#f2e9dc;color:var(--brand)}
.mini-btn.answer{background:#edf8f1;color:var(--success)}
.mini-btn.translation{background:#fff4e8;color:#9b5718}
.reveal{display:none;margin-top:12px;padding:14px;border-radius:14px;line-height:1.7}
.reveal.show{display:block}
.reveal.answer{background:#effaf2;border:1px dashed #99d5b4}
.reveal.translation{background:#fff8ef;border:1px dashed #e6bf8e}
.reading-block{line-height:1.85;font-size:17px;color:#25211d}
.word{color:#7b432e;font-weight:900;border-bottom:2px dotted #c79a63;cursor:pointer}
.pop{
