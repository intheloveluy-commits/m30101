  background:transparent;color:#f2ebe4;font-size:14px;line-height:1.35;transition:.2s ease
}
.navbtn:hover,.navbtn.active{
  background:linear-gradient(90deg, rgba(229,200,159,.18), rgba(255,255,255,.08));
  color:#fff;transform:translateX(2px)
}
.navbtn small{display:block;color:#d3c1ad;font-size:12px;margin-top:2px}
.main{padding:28px}
.hero{
  background:linear-gradient(135deg, rgba(255,255,255,.82), rgba(255,250,245,.74));
  border:1px solid rgba(255,255,255,.85);
  backdrop-filter: blur(10px);
  box-shadow:var(--shadow);
  border-radius:32px;padding:28px 30px;margin-bottom:22px
}
.hero .eyebrow{
  display:inline-flex;align-items:center;gap:8px;padding:7px 12px;border-radius:999px;
  background:#f4ede5;border:1px solid #eadccb;color:var(--brand);font-weight:800;font-size:12px;letter-spacing:.06em;text-transform:uppercase
}
.hero h2{margin:14px 0 8px;font-size:34px;letter-spacing:-.03em}
.hero p{margin:0;color:var(--muted);font-size:16px;line-height:1.7}
.page{display:none;max-width:1280px;margin:0 auto}
.page.active{display:block}
.surface{
  background:var(--panel-2);
  border:1px solid rgba(255,255,255,.85);
  backdrop-filter:blur(9px);
  box-shadow:var(--shadow);
  border-radius:var(--radius);
  padding:22px;margin-bottom:18px
}
.surface h3{margin:0 0 14px;font-size:22px;letter-spacing:-.02em}
.note{color:var(--muted);font-size:14px;line-height:1.6}
.tablewrap{overflow:auto}
table{width:100%;border-collapse:separate;border-spacing:0;min-width:850px}
th,td{padding:13px 14px;border-bottom:1px solid var(--line);vertical-align:top}
th{background:#f6efe7;color:var(--brand);font-size:14px;text-align:left}
