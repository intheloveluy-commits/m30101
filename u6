      <div class="option-grid">
        ${options.map((o,idx)=>`<button class="choice" data-word="${o.replace(/"/g,'&quot;')}"><span>${String.fromCharCode(65+idx)}</span>${o}</button>`).join('')}
      </div>
      <div class="feedback" id="quizFeedback"></div>
      <div style="margin-top:16px"><button class="btn" id="quizNext" style="display:none" onclick="nextQuiz()">ข้อต่อไป</button></div>
    </div>`;
  document.querySelectorAll('.choice').forEach(btn=>{
    btn.addEventListener('click', ()=>answerQuiz(btn, btn.dataset.word, item[0]));
  });
}
function answerQuiz(btn, selected, correct){
  if(quizLocked) return;
  quizLocked = true;
  const buttons=[...document.querySelectorAll('.choice')];
  buttons.forEach(b=>b.disabled=true);
  const fb=document.getElementById('quizFeedback');
  if(selected===correct){
    quizScore++; btn.classList.add('correct');
    fb.textContent='✅ ถูกต้อง'; fb.style.color='var(--success)';
  }else{
    btn.classList.add('wrong');
    const right = buttons.find(b=>b.dataset.word===correct);
    if(right) right.classList.add('correct');
    fb.textContent = `❌ คำตอบที่ถูกคือ ${correct}`; fb.style.color='var(--danger)';
  }
  document.getElementById('quizScore').textContent = `คะแนน: ${quizScore}`;
  document.getElementById('quizNext').style.display = 'inline-flex';
}
function nextQuiz(){ quizIndex++; renderVocabQuestion(); }

let memCards=[], openCards=[], memMoves=0, memMatches=0, memLock=false;
function newMemoryGame(){
  const selected = shuffle(vocab).slice(0,8);
  memCards = shuffle(selected.flatMap((v,i)=>[
    {id:i, text:`${getEmoji(v[0])} ${v[0]}`},
    {id:i, text:v[3]}
  ]));
  openCards=[]; memMoves=0; memMatches=0; memLock=false;
  document.getElementById('moves').textContent='Moves: 0';
  document.getElementById('matches').textContent='Matches: 0/8';
  const board=document.getElementById('memoryBoard');
  board.innerHTML = memCards.map((c,idx)=>`<button class="mem-card front" data-index="${idx}">✦</button>`).join('');
  board.querySelectorAll('.mem-card').forEach(btn=>btn.addEventListener('click', ()=>flipCard(btn)));
}
function flipCard(btn){
  if(memLock) return;
  const idx = Number(btn.dataset.index);
  const card = memCards[idx];
  if(btn.classList.contains('matched') || btn.classList.contains('open')) return;
  btn.classList.remove('front'); btn.classList.add('open'); btn.textContent = card.text;
  openCards.push({btn,card});
  if(openCards.length===2){
    memMoves++; document.getElementById('moves').textContent=`Moves: ${memMoves}`;
    const [a,b]=openCards;
    if(a.card.id===b.card.id){
      a.btn.classList.add('matched'); b.btn.classList.add('matched');
      memMatches++; document.getElementById('matches').textContent=`Matches: ${memMatches}/8`;
      openCards=[];
    }else{
      memLock=true;
      setTimeout(()=>{
        [a.btn,b.btn].forEach(x=>{x.classList.add('front'); x.classList.remove('open'); x.textContent='✦';});
        openCards=[]; memLock=false;
      },700);
    }
  }
}

function markTarget(sentence, target){
  return sentence.replace(new RegExp(escapeReg(target), 'i'), m=>`<span class="under">${m}</span>`);
}
function toggleReveal(id, group, event){
  event.stopPropagation();
  document.querySelectorAll('.reveal').forEach(el=>{ if(el.dataset.group!==group) el.classList.remove('show'); });
  const box=document.getElementById(id); if(box) box.classList.toggle('show');
}
function hideAllReveals(){ document.querySelectorAll('.reveal').forEach(x=>x.classList.remove('show')); }

function buildPreview(){
  document.getElementById('previewBox').innerHTML = preview.map((x,i)=>{
    const group=`pv-${i}`;
    return `
      <div class="preview-item">
        <div><b>${markTarget(x[0], x[1])}</b></div>
        <div class="action-row">
          <button class="mini-btn translation" onclick="toggleReveal('pv-th-${i}','${group}',event)">🌐 แสดงคำแปล</button>
          <button class="mini-btn answer" onclick="toggleReveal('pv-ans-${i}','${group}',event)">✅ แสดงคำตอบ</button>
        </div>
        <div class="reveal translation" id="pv-th-${i}" data-group="${group}"><b>คำแปล:</b> ${x[3]}</div>
        <div class="reveal answer" id="pv-ans-${i}" data-group="${group}"><b>Answer:</b> ${x[2]}. ${previewChoiceText[x[2]]}</div>
      </div>`;
  }).join('');
}

function buildReading(){
  document.getElementById('readingPlain').innerHTML = reading.map((s,i)=>`<div class="sentence"><b>${i+1}.</b> ${s}</div>`).join('');
  document.getElementById('readingTranslated').innerHTML = reading.map((s,i)=>`
    <div class="sentence">
      <div><b>${i+1}. ${s}</b></div>
      <div class="thai">${thaiReading[i]}</div>
    </div>`).join('');
}
function clickableText(text){
  let out=text;
  [...vocab].sort((a,b)=>b[0].length-a[0].length).forEach(v=>{
    const re=new RegExp(`\\b${escapeReg(v[0])}\\b`, 'gi');
    out = out.replace(re, m=>`<span class="word" data-meaning="${v[3]}">${m}</span>`);
  });
  return out;
}
function buildClickable(){
  const holder=document.getElementById('readingClickable');
  holder.innerHTML = reading.map((s,i)=>`<div class="sentence"><b>${i+1}.</b> ${clickableText(s)}</div>`).join('');
  holder.querySelectorAll('.word').forEach(w=>w.addEventListener('click', e=>{e.stopPropagation(); showPop(w, w.dataset.meaning);}));
}
function showPop(el,text){
  document.querySelectorAll('.pop').forEach(x=>x.remove());
  const rect = el.getBoundingClientRect();
  const pop = document.createElement('div');
  pop.className='pop'; pop.textContent=text;
  pop.style.left=(rect.left + window.scrollX)+'px';
  pop.style.top=(rect.bottom + window.scrollY + 8)+'px';
  document.body.appendChild(pop);
}

function buildRC(){
  document.getElementById('rcBox').innerHTML = rc.map((q,i)=>{
    const group=`rc-${i}`;
    return `
      <div class="qa">
        <div><b>${q.q}</b></div>
        <div class="rc-choices">${q.opts.map(o=>`<div>${o}</div>`).join('')}</div>
        <div class="action-row">
          <button class="mini-btn translation" onclick="toggleReveal('rc-th-${i}','${group}',event)">🌐 แสดงคำแปล</button>
          <button class="mini-btn answer" onclick="toggleReveal('rc-ans-${i}','${group}',event)">✅ แสดงคำตอบ</button>
        </div>
        <div class="reveal translation" id="rc-th-${i}" data-group="${group}"><b>${q.thaiQ}</b><div style="margin-top:8px">${q.thaiOpts.map(o=>`<div>${o}</div>`).join('')}</div></div>
        <div class="reveal answer" id="rc-ans-${i}" data-group="${group}"><b>Answer:</b> ${q.ans}</div>
      </div>`;
  }).join('');
}

function buildIdioms(){
  const holder=document.getElementById('idiomBox');
  let html = '<h3>Find these idioms in the reading.</h3>';
  html += idioms.map((it,i)=>{
    const group=`id-${i}`;
    return `
      <div class="idiom">
        <div><b>${it[0]}</b></div>
        <div class="note" style="margin-top:8px">${it[3]}</div>
        <div class="action-row">
          <button class="mini-btn translation" onclick="toggleReveal('id-th-${i}','${group}',event)">🌐 แสดงคำแปล</button>
          <button class="mini-btn answer" onclick="toggleReveal('id-ans-${i}','${group}',event)">✅ แสดงคำตอบ</button>
        </div>
        <div class="reveal translation" id="id-th-${i}" data-group="${group}"><b>คำแปลสำนวน:</b> ${it[2]}<br><b>คำแปลประโยคตัวอย่าง:</b> ${it[4]}</div>
        <div class="reveal answer" id="id-ans-${i}" data-group="${group}"><b>Meaning:</b> ${it[1]}</div>
      </div>`;
  }).join('');
  html += '<h3 style="margin-top:22px">Fill in the blank</h3>';
  html += idiomExercises.map((ex,i)=>{
    const group=`iex-${i}`;
    return `
      <div class="qa">
        <div><b>${ex[0]}</b></div>
        <div class="action-row">
          <button class="mini-btn translation" onclick="toggleReveal('iex-th-${i}','${group}',event)">🌐 แสดงคำแปล</button>
          <button class="mini-btn answer" onclick="toggleReveal('iex-ans-${i}','${group}',event)">✅ แสดงคำตอบ</button>
        </div>
        <div class="reveal translation" id="iex-th-${i}" data-group="${group}"><b>คำแปล:</b> ${ex[2]}</div>
        <div class="reveal answer" id="iex-ans-${i}" data-group="${group}"><b>Answer:</b> ${ex[1]}</div>
      </div>`;
  }).join('');
  holder.innerHTML = html;
}

function buildSummary(){
  document.getElementById('summaryBox').innerHTML = summaryItems.map((s,i)=>{
    const group=`sum-${i}`;
    return `
      <div class="summary-block">
        <div class="badge">Summary ${i+1}</div>
        ${s.source.map(line=>`<div class="summary-source">${line}</div>`).join('')}
        <div class="action-row">
          <button class="mini-btn translation" onclick="toggleReveal('sum-th-${i}','${group}',event)">🌐 แสดงคำแปล</button>
          <button class="mini-btn answer" onclick="toggleReveal('sum-ans-${i}','${group}',event)">✅ แสดงคำตอบ</button>
        </div>
        <div class="reveal translation" id="sum-th-${i}" data-group="${group}"><b>คำแปลสรุป:</b> ${s.thai}</div>
        <div class="reveal answer" id="sum-ans-${i}" data-group="${group}"><b>Answer:</b> ${s.answer}</div>
      </div>`;
  }).join('');
}

document.addEventListener('click',()=>{
  hideAllReveals();
  document.querySelectorAll('.pop').forEach(x=>x.remove());
});

initNav();
buildVocab();
startVocabQuiz();
newMemoryGame();
buildPreview();
buildReading();
buildClickable();
buildRC();
buildIdioms();
buildSummary();
</script>
</body>
