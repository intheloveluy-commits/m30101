  --ink:#1f1d1a;
  --muted:#6c665f;
  --line:#e6ddd1;
  --brand:#6d3b2d;
  --brand-2:#9f684c;
  --accent:#c79a63;
  --accent-2:#e5c89f;
  --success:#18794e;
  --danger:#b42318;
