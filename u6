.thai{margin-top:8px;color:#5d564f;line-height:1.75}
.rc-choices div{padding:3px 0}
.summary-source{margin:8px 0;padding:13px;border-radius:14px;background:#f9f5f0;border:1px solid #eee1d0}
.footer{margin-top:18px;color:#8b8379;font-size:13px;text-align:center;padding-bottom:18px}

@media (max-width:1000px){
  .shell{grid-template-columns:1fr}
  .sidebar{position:relative;height:auto}
  .main{padding:18px}
  .option-grid,.grid2{grid-template-columns:1fr}
  .memory-board{grid-template-columns:repeat(2,1fr)}
  .hero h2{font-size:28px}
}
</style>
</head>
