  margin-bottom:18px
}
.brandbox h1{font-size:28px;line-height:1.05;margin:0 0 8px;font-weight:900;letter-spacing:-.02em}
.brandbox p{margin:0;color:#e7d9c8;line-height:1.5;font-size:14px}
.navwrap{display:flex;flex-direction:column;gap:8px;margin-top:18px;max-height:calc(100vh - 220px);overflow:auto;padding-right:4px}
.navbtn{
