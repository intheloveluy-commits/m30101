.quiz-hint{font-size:68px;line-height:1;margin:16px 0 10px}
.quiz-title{font-size:30px;font-weight:900;letter-spacing:-.03em;margin:0 0 12px}
.quiz-sub{color:var(--muted);margin-bottom:20px;line-height:1.6}
.option-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}
.choice{
  text-align:left;padding:16px 18px;border-radius:18px;border:1px solid #e7dccd;background:#fff;
  box-shadow:0 8px 18px rgba(34,17,4,.04);cursor:pointer;font-weight:800;color:var(--ink)
}
.choice span{display:inline-flex;width:30px;height:30px;border-radius:50%;align-items:center;justify-content:center;background:#f5eee7;color:var(--brand);margin-right:10px;font-size:13px}
.choice:hover{border-color:#d4b28a;background:#fffaf3}
.choice.correct{background:#eef9f2;border-color:#9ad0b4;color:var(--success)}
.choice.wrong{background:#fdf2f2;border-color:#efb4af;color:var(--danger)}
.feedback{min-height:28px;margin-top:14px;font-weight:900}
.memory-board{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.mem-card{
  aspect-ratio:1.38/1;border-radius:18px;padding:14px;border:1px solid #eadccb;cursor:pointer;
  background:linear-gradient(135deg,#fffdfb,#f6eee4);box-shadow:0 10px 22px rgba(73,43,14,.05);
