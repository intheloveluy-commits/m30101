function initNav(){
  const nav = document.getElementById('nav');
  pages.forEach((p,i)=>{
    const btn=document.createElement('button');
    btn.className='navbtn'+(i===0?' active':'');
    btn.innerHTML=`<div>${i+1}. ${p[0]}</div><small>${p[1]}</small>`;
    btn.onclick=()=>showPage(i+1, btn);
    nav.appendChild(btn);
  });
}
function showPage(n, btn){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('p'+n).classList.add('active');
  document.querySelectorAll('.navbtn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');
  hideAllReveals();
  document.querySelectorAll('.pop').forEach(x=>x.remove());
  window.scrollTo({top:0, behavior:'smooth'});
}
function shuffle(arr){ return [...arr].sort(()=>Math.random()-.5); }
function escapeReg(str){ return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }

function buildVocab(){
  const t=document.getElementById('vocabTable');
  t.innerHTML = `
    <tr><th>#</th><th>English</th><th>Part of Speech</th><th>คำอ่าน</th><th>คำแปล</th></tr>
    ${vocab.map((v,i)=>`
      <tr>
        <td>${i+1}</td>
        <td><div class="vocab-word"><span class="emoji">${getEmoji(v[0])}</span><span>${v[0]}</span></div></td>
        <td>${v[1]}</td>
        <td>${v[2]}</td>
        <td>${v[3]}</td>
      </tr>`).join('')}`;
}

let quizList=[], quizIndex=0, quizScore=0, quizLocked=false;
function startVocabQuiz(){
  quizList = shuffle(vocab).slice(0,10);
  quizIndex = 0; quizScore = 0; quizLocked = false;
  renderVocabQuestion();
}
function renderVocabQuestion(){
  const box=document.getElementById('quizBox');
  document.getElementById('quizScore').textContent = `คะแนน: ${quizScore}`;
