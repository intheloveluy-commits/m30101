    box.innerHTML = `
      <div class="quiz-card">
        <div class="quiz-hint">🏆</div>
        <div class="quiz-title">ทำครบแล้ว</div>
        <div class="quiz-sub">คะแนนรวมของคุณคือ <b>${quizScore}/10</b></div>
        <button class="btn" onclick="startVocabQuiz()">เริ่มใหม่อีกครั้ง</button>
      </div>`;
    return;
  }
  const item = quizList[quizIndex];
  const wrong = shuffle(vocab.filter(v=>v[0]!==item[0])).slice(0,3).map(v=>v[0]);
  const options = shuffle([item[0], ...wrong]);
  quizLocked = false;
  box.innerHTML = `
