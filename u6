.mem-card.front{background:linear-gradient(135deg,#6d3b2d,#9f684c);color:#fff;border-color:transparent}
.mem-card.matched{background:#effaf2;border-color:#97d3b0;color:#186e4b}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.preview-item,.qa,.idiom,.summary-block,.sentence{
  padding:18px;border:1px solid var(--line);border-radius:18px;background:#fffdfb;margin-bottom:12px
